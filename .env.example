# Скопируй этот файл в .env и заполни пустые значения.
# Секреты генерируй так: openssl rand -hex 24

# PostgreSQL. POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB читают и контейнер базы, и API.
POSTGRES_USER=jdm
POSTGRES_DB=jdm_garage
POSTGRES_PASSWORD=
# Адрес базы со стороны хоста: контейнер отдан на 127.0.0.1:5433. Нужен только API.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# Хранилище объектов (RustFS). Ключи читают и контейнер, и API.
RUSTFS_ACCESS_KEY=jdm-garage
RUSTFS_SECRET_KEY=

# Параметры хранилища для API.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=photos

# API. Все четыре имеют значения по умолчанию — строки можно не задавать.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
